{
  "manifest_version": 3,
  "name": "Tavin Painel · WhatsApp",
  "version": "1.0.0",
  "description": "Abre as conversas do painel da Tavin Digital na aba do WhatsApp Web que já está aberta, sem abrir aba nova.",
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["https://tavindigital.online/*", "https://www.tavindigital.online/*", "http://localhost/*"],
      "js": ["painel.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icone.png" }
}
