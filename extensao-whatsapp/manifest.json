{
  "manifest_version": 3,
  "name": "Tavin Painel · WhatsApp",
  "version": "1.1.0",
  "description": "Abre as conversas do painel da Tavin Digital direto na aba do WhatsApp Web que já está aberta, com o texto pronto e sem recarregar.",
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tavindigital.online/*",
        "https://www.tavindigital.online/*",
        "http://localhost/*"
      ],
      "js": [
        "painel.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icone.png"
  },
  "permissions": [
    "scripting"
  ]
}